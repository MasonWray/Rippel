{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "rippel",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "rippel/client"
    ]
  },
  "include": [
    "src",
    "rippel.config.ts"
  ]
}
