CONFIG_IDF_TARGET="esp32s3"

# The QT Py's USB port is the chip's own USB, so the console goes there.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Full speed. ESP-IDF starts the S3 at 160 MHz.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# LVGL renders on the main task, and its software renderer overflows the default 3.5 KB stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Use the lv_conf.h that `rippel build` generates, not LVGL's Kconfig options.
CONFIG_LV_CONF_SKIP=n

# LVGL's examples and demos need widgets this UI has turned off.
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
